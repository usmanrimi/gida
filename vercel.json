{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/registrations/export",
      "destination": "/api/admin-registrations.js"
    },
    {
      "source": "/api/admin/registrations",
      "destination": "/api/admin-registrations.js"
    },
    {
      "source": "/api/get-cms",
      "destination": "/api/get-cms.js"
    },
    {
      "source": "/api/save-cms",
      "destination": "/api/save-cms.js"
    },
    {
      "source": "/registration",
      "destination": "/register.html"
    },
    {
      "source": "/registration.html",
      "destination": "/register.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/event-registration",
      "destination": "/register.html"
    },
    {
      "source": "/admin/:subpath*",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
